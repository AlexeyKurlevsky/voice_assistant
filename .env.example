# --- База данных ---
MS_DB_DSN=postgres://postgres:postgres@localhost:5432/voice_assistant?sslmode=disable
MS_DB_MAX_CONNS=10
MS_MIGRATE_ON_START=true

# --- Файлы ---
MS_UPLOAD_DIR=./data/uploads
MS_MAX_UPLOAD_BYTES=104857600

# --- Обработка ---
MS_WORKER_CONCURRENCY=3
MS_JOB_QUEUE_CAPACITY=100
MS_SHUTDOWN_TIMEOUT=10s

# --- Таймауты внешних шагов ---
MS_SPEECH_TIMEOUT=120s
MS_LLM_TIMEOUT=60s

# --- Провайдеры ---
MS_SPEECH_PROVIDER=mock
MS_LLM_PROVIDER=mock

# --- Speech: mock (задержка эмулирует реальный вызов) ---
MS_MOCK_SPEECH_DELAY=2s
# MS_SPEECH_PROVIDER=whisper (план) + MS_WHISPER_BASE_URL / MS_WHISPER_API_KEY / MS_WHISPER_MODEL

# --- LLM: OpenRouter (OpenAI-совместимый, используется при MS_LLM_PROVIDER=openrouter) ---
MS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MS_OPENROUTER_API_KEY=
MS_OPENROUTER_MODEL=
MS_MOCK_LLM_DELAY=1s

# --- Аутентификация ---
# MS_TOKEN=<session-токен>   (или файл ~/.voice-assistant-token)

# --- Логи ---
MS_LOG_LEVEL=info
MS_LOG_FORMAT=text
