# --- База данных ---
MS_DB_DSN=postgres://postgres:postgres@localhost:5432/voice_assistant?sslmode=disable
MS_DB_MAX_CONNS=10
MS_MIGRATE_ON_START=true

# --- Файлы ---
MS_UPLOAD_DIR=./data/uploads
MS_MAX_UPLOAD_BYTES=104857600

# --- Обработка ---
MS_WORKER_CONCURRENCY=3
MS_JOB_QUEUE_CAPACITY=100
MS_SHUTDOWN_TIMEOUT=10s

# --- Провайдеры (будут использованы в батче 3) ---
MS_SPEECH_PROVIDER=mock
MS_LLM_PROVIDER=mock

# --- Логи ---
MS_LOG_LEVEL=info
MS_LOG_FORMAT=text